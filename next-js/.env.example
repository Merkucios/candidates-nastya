# Neon Postgres (pooled) — required by Prisma runtime
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require

# Unpooled — use for `prisma db push` / migrations if pooler drops connection
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Admin master password (admin panel login)
ADMIN_PASSWORD=change-me

# Optional: secret for signing admin session cookie
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
