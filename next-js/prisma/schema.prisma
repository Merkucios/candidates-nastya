generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum QuestionType {
  single
  multiple
  text
}

model Candidate {
  id                    String   @id @default(uuid()) @db.Uuid
  fullName              String   @map("full_name")
  phone                 String
  email                 String
  createdAt             DateTime @default(now()) @map("created_at")
  score                 Int?
  totalScoredQuestions  Int?     @map("total_scored_questions")
  answers               Answer[]

  @@map("candidates")
}

model Question {
  id           String           @id @default(uuid()) @db.Uuid
  questionText String           @map("question_text")
  type         QuestionType
  orderIndex   Int              @map("order_index")
  createdAt    DateTime         @default(now()) @map("created_at")
  options      QuestionOption[]
  answers      Answer[]

  @@map("questions")
}

model QuestionOption {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  optionText String   @map("option_text")
  isCorrect  Boolean  @map("is_correct")
  orderIndex Int      @map("order_index")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model Answer {
  id          String    @id @default(uuid()) @db.Uuid
  candidateId String    @map("candidate_id") @db.Uuid
  questionId  String    @map("question_id") @db.Uuid
  answerGiven Json?     @map("answer_given")
  answerText  String?   @map("answer_text")
  isCorrect   Boolean?  @map("is_correct")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("answers")
}

model Settings {
  id               String   @id @default(uuid()) @db.Uuid
  video1Url        String   @default("") @map("video_1_url")
  video2Url        String   @default("") @map("video_2_url")
  presentationUrl  String   @default("") @map("presentation_url")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("settings")
}
